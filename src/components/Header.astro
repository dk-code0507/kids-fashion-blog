---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="site-title">
			<a href="/">
				<span class="title-icon">👶</span>
				<span class="title-text">こどもふく図鑑</span>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/reviews/">レビュー</HeaderLink>
			<HeaderLink href="/guides/">ガイド</HeaderLink>
			<HeaderLink href="/about">このサイトについて</HeaderLink>
		</div>
		<button class="hamburger" id="hamburger" aria-label="メニュー" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
	</nav>
	<div class="mobile-menu" id="mobile-menu" hidden>
		<a href="/reviews/">📝 レビュー一覧</a>
		<a href="/guides/">💡 お悩み解決ガイド</a>
		<a href="/about">ℹ️ このサイトについて</a>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		background: #fff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.2em;
		height: 56px;
	}
	.site-title a {
		display: flex;
		align-items: center;
		gap: 0.4em;
		text-decoration: none;
		color: #333;
		font-weight: bold;
		font-size: 1.05em;
	}
	.title-icon {
		font-size: 1.3em;
	}
	.title-text {
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
	}
	.internal-links :global(a) {
		padding: 0.5em 0.7em;
		color: #555;
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.92em;
		transition: color 0.15s, border-color 0.15s;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: #f5a623;
		border-bottom-color: #f5a623;
	}
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}
	.hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background: #555;
		border-radius: 2px;
	}
	.mobile-menu[hidden] {
		display: none;
	}
	.mobile-menu {
		display: flex;
		flex-direction: column;
		background: #fff;
		border-top: 1px solid #eee;
		padding: 0.5em 0;
	}
	.mobile-menu a {
		padding: 0.8em 1.5em;
		text-decoration: none;
		color: #333;
		font-size: 0.95em;
		border-bottom: 1px solid #f5f5f5;
	}
	.mobile-menu a:hover {
		background: #fffbf2;
		color: #f5a623;
	}
	@media (max-width: 640px) {
		.internal-links {
			display: none;
		}
		.hamburger {
			display: flex;
		}
	}
</style>

<script>
	const btn = document.getElementById('hamburger');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		const open = menu?.hidden === false;
		if (menu) menu.hidden = open;
		btn?.setAttribute('aria-expanded', String(!open));
	});
</script>
