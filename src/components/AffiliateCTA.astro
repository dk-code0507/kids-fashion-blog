---
/**
 * AffiliateCTA.astro
 * 商品画像＋アフィリエイトリンクを横並びで表示するコンポーネント。
 * 使い方:
 *   <AffiliateCTA
 *     title="レゴ デュプロの価格を確認する"
 *     image="https://images.unsplash.com/..."   // 省略可
 *     links={{
 *       rakuten: { url: "https://...", label: "楽天市場" },
 *       amazon: { url: "https://...", label: "Amazon" },
 *     }}
 *     note="誕生日プレゼントにも人気"
 *   />
 */

interface AffiliateLink {
	url: string;
	label: string;
}

interface Props {
	title?: string;
	image?: string;
	links: {
		gap?: AffiliateLink;
		rakuten?: AffiliateLink;
		amazon?: AffiliateLink;
		other?: AffiliateLink[];
	};
	note?: string;
}

const {
	title = '購入・価格を確認する',
	image,
	links,
	note,
} = Astro.props;

const allLinks = [
	links.gap && { ...links.gap, icon: '🏪', color: '#004F93' },
	links.rakuten && { ...links.rakuten, icon: '🛒', color: '#BF0000' },
	links.amazon && { ...links.amazon, icon: '📦', color: '#FF9900' },
	...(links.other ?? []).map((l) => ({ ...l, icon: '🔗', color: '#555' })),
].filter(Boolean);
---

<div class={`affiliate-cta${image ? ' has-image' : ''}`}>
	{image && (
		<div class="affiliate-cta__img-wrap">
			<img src={image} alt={title} loading="lazy" />
		</div>
	)}
	<div class="affiliate-cta__body">
		<p class="affiliate-cta__title">{title}</p>
		{note && <p class="affiliate-cta__note">{note}</p>}
		<div class="affiliate-cta__links">
			{allLinks.map((link) => (
				<a
					href={link!.url}
					target="_blank"
					rel="nofollow sponsored noopener noreferrer"
					class="affiliate-cta__btn"
					style={`--btn-color: ${link!.color}`}
				>
					<span class="affiliate-cta__icon">{link!.icon}</span>
					{link!.label}で見る
				</a>
			))}
		</div>
		<p class="affiliate-cta__disclosure">※ 本リンクはアフィリエイトリンクです。リンク経由でご購入いただいても、お客様の購入価格は変わりません。</p>
	</div>
</div>

<style>
	.affiliate-cta {
		background: #fffbf2;
		border: 2px solid #f5a623;
		border-radius: 12px;
		padding: 1.2em 1.4em;
		margin: 2em 0;
		display: flex;
		gap: 1.2em;
		align-items: center;
	}

	/* 画像あり */
	.affiliate-cta__img-wrap {
		flex-shrink: 0;
		width: 120px;
		height: 120px;
		border-radius: 8px;
		overflow: hidden;
		background: #f5f5f5;
	}
	.affiliate-cta__img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.affiliate-cta__body {
		flex: 1;
		min-width: 0;
	}

	.affiliate-cta__title {
		font-weight: bold;
		font-size: 0.97em;
		margin: 0 0 0.5em;
		color: #333;
		line-height: 1.4;
	}

	.affiliate-cta__note {
		font-size: 0.83em;
		color: #666;
		margin: 0 0 0.7em;
		line-height: 1.5;
	}

	.affiliate-cta__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 0.6em;
	}

	.affiliate-cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		background: var(--btn-color, #555);
		color: #fff;
		text-decoration: none;
		padding: 0.45em 1.1em;
		border-radius: 6px;
		font-size: 0.85em;
		font-weight: bold;
		transition: opacity 0.2s;
		white-space: nowrap;
	}

	.affiliate-cta__btn:hover {
		opacity: 0.85;
	}

	.affiliate-cta__icon {
		font-size: 1em;
	}

	.affiliate-cta__disclosure {
		font-size: 0.68em;
		color: #bbb;
		margin: 0;
		line-height: 1.5;
	}

	@media (max-width: 480px) {
		.affiliate-cta {
			flex-direction: column;
			align-items: flex-start;
		}
		.affiliate-cta__img-wrap {
			width: 100%;
			height: 160px;
		}
	}
</style>
