---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const reviews = (await getCollection('reviews')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// カテゴリ一覧を取得
const categories = [...new Set(reviews.map((r) => r.data.category))];
---

<html lang="ja">
	<head>
		<BaseHead
			title={`レビュー一覧 | ${SITE_TITLE}`}
			description="1〜3歳の子ども服を実際に着せた正直レビュー一覧。ブランド別・カテゴリ別に探せます。"
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2em auto;
				padding: 0 1em;
			}
			h1 {
				font-size: 1.6em;
				margin-bottom: 0.3em;
			}
			.subtitle {
				color: #888;
				font-size: 0.9em;
				margin-bottom: 1.5em;
			}
			.filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 1.5em;
			}
			.filter-btn {
				background: #f0f0f0;
				border: none;
				border-radius: 20px;
				padding: 0.3em 0.9em;
				font-size: 0.82em;
				cursor: pointer;
				color: #555;
				text-decoration: none;
			}
			.filter-btn:hover,
			.filter-btn.active {
				background: #f5a623;
				color: #fff;
			}
			.card-list {
				list-style: none;
				padding: 0;
				display: grid;
				gap: 1em;
			}
			.card {
				border: 1px solid #e8e8e8;
				border-radius: 8px;
				padding: 1em 1.2em;
				transition: box-shadow 0.2s;
			}
			.card:hover {
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
			}
			.card a {
				text-decoration: none;
				color: inherit;
			}
			.card-meta {
				font-size: 0.8em;
				color: #999;
				margin-bottom: 0.3em;
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				align-items: center;
			}
			.card-title {
				font-size: 1em;
				font-weight: bold;
				margin: 0 0 0.3em;
			}
			.category-badge {
				background: #f5a623;
				color: #fff;
				border-radius: 4px;
				padding: 0.1em 0.5em;
				font-size: 0.78em;
			}
			.rating {
				color: #f5a623;
				font-size: 0.85em;
				font-weight: bold;
			}
			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3em;
				margin-top: 0.5em;
			}
			.tag {
				background: #f0f0f0;
				border-radius: 4px;
				padding: 0.1em 0.5em;
				font-size: 0.72em;
				color: #555;
			}
			.count {
				font-size: 0.85em;
				color: #999;
				margin-bottom: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav style="font-size:0.8em;color:#aaa;margin-bottom:1em;">
				<a href="/" style="color:#aaa;text-decoration:none;">ホーム</a> &rsaquo; レビュー一覧
			</nav>
			<h1>子ども服レビュー一覧</h1>
			<p class="subtitle">1〜3歳の子ども服を実際に着せた正直レビュー</p>

			<div class="filter-bar">
				<a href="/reviews/" class="filter-btn active">すべて</a>
				{categories.map((cat) => (
					<a href={`/reviews/?category=${encodeURIComponent(cat)}`} class="filter-btn">{cat}</a>
				))}
			</div>

			<p class="count">{reviews.length}件のレビュー</p>

			<ul class="card-list">
				{reviews.map((post) => (
					<li class="card">
						<a href={`/reviews/${post.id}/`}>
							<div class="card-meta">
								<span class="category-badge">{post.data.category}</span>
								<FormattedDate date={post.data.date} />
								{post.data.rating && (
									<span class="rating">★ {post.data.rating}</span>
								)}
							</div>
							<p class="card-title">{post.data.title}</p>
							{post.data.description && (
								<p style="font-size:0.85em;color:#666;margin:0.3em 0 0;">{post.data.description}</p>
							)}
							{post.data.tags.length > 0 && (
								<div class="card-tags">
									{post.data.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
