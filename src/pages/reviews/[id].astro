---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('reviews');
	return posts.map((post) => ({ params: { id: post.id }, props: post }));
}

const post = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, category, tags, rating } = post.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// JSON-LD: Article + BreadcrumbList + (Review if rating exists)
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description ?? title,
	datePublished: date.toISOString(),
	dateModified: (updated ?? date).toISOString(),
	author: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL.toString(),
	},
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site?.toString() },
		{ '@type': 'ListItem', position: 2, name: 'レビュー', item: new URL('/reviews/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL.toString() },
	],
};

const reviewJsonLd = rating
	? {
			'@context': 'https://schema.org',
			'@type': 'Review',
			name: title,
			description: description ?? title,
			reviewRating: {
				'@type': 'Rating',
				ratingValue: rating,
				bestRating: 5,
				worstRating: 1,
			},
			author: {
				'@type': 'Organization',
				name: SITE_TITLE,
			},
			datePublished: date.toISOString(),
		}
	: null;
---

<html lang="ja">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description ?? title} />
		<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		{reviewJson